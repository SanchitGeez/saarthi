ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://saarthi:saarthi@localhost:5432/saarthi
APP_ORIGIN=http://localhost:8000
OPENROUTER_API_KEY=
# Model/effort/provider come from SAARTHI_MODEL at the top of config.py.
# Optional explicit override (takes precedence over that switch):
# AGENT_MODEL=openrouter/minimax/minimax-m3.1-flash:free
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_OUTPUT_TOKENS=4096
# provider_default preserves model defaults; low/medium are optional dialogue experiments.
# AGENT_REASONING_EFFORT=provider_default
SESSION_DAYS=7
# Optional endpoint pin; unset preserves automatic routing. Example for a Luna trial:
# AGENT_PROVIDER=openai
