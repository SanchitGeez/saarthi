{
  "expo": {
    "name": "Saarthi",
    "slug": "saarthi",
    "scheme": "saarthi",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saarthi.companion",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Talk with Parth in a live conversation. Audio is processed for speech and is not recorded by Saarthi."
      }
    },
    "android": {
      "package": "com.saarthi.companion",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Record a voice note to share with Saarthi. The app sends it for transcription and does not save the audio.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
