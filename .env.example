# Copy to .env for this project. Do not copy credentials from another app's database.
APP_ENV=development
SAARTHI_DATABASE_URL=postgresql+asyncpg://saarthi:saarthi@localhost:54330/saarthi
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# Explicit LLM selection applies to both voice calls and typed chat.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Optional alternate LLM_PROVIDER=gemini.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# One fallback on upstream 429/503. Set empty to disable.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional: the local API may load these from ../mindlap/.env for memory embeddings.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Explicit speech selections; unused provider keys are not required.
STT_PROVIDER=elevenlabs
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
TTS_PROVIDER=elevenlabs
MURF_API_KEY=
# Existing MURF_AI key name also works.
MURF_MODEL=FALCON
MURF_VOICE=en-IN-abhinav
MURF_STYLE=Conversational
# Leave blank for the voice default; set hi-IN for Hindi synthesis.
MURF_LOCALE=
# Alternates: STT_PROVIDER=deepgram and/or TTS_PROVIDER=murf.
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVEN_LABS_TTS_MODEL=eleven_multilingual_v2
ELEVEN_LABS_STT_MODEL=scribe_v2

# Production email OTP delivery. Local development shows the code in the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Expo mobile client. Android emulator default is 10.0.2.2:8000.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# LiveKit Cloud: secrets remain on the API/worker, never in EXPO_PUBLIC_* variables.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=saarthi-parth
VOICE_MAX_SECONDS=900
VOICE_IDLE_SECONDS=120
VOICE_TTS_MODEL=eleven_multilingual_v2
